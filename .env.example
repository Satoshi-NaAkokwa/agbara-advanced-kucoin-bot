# KuCoin API Credentials (Get from https://www.kucoin.com/account/api)
KUCOIN_API_KEY=your_api_key_here
KUCOIN_SECRET_KEY=your_secret_key_here
KUCOIN_API_PASSPHRASE=your_passphrase_here

# Environment
NODE_ENV=production
LOG_LEVEL=info
TZ=Asia/Singapore

# Trading Configuration
MAX_POSITION_SIZE=6
RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=500
LEVERAGE=1
COMPOUND_THRESHOLD=15

# LLM Configuration
LLM_ENDPOINT=http://localhost:11434/api/generate
LLM_MODEL=llama2
LLM_TIMEOUT=30000

# Trading Pairs
TRADING_PAIRS=BTC-USDT,ETH-USDT,SOL-USDT
SCALPING_PAIRS=SOL-USDT,DOGE-USDT,PEPE-USDT,WIF-USDT,BONK-USDT
MOMENTUM_PAIRS=BTC-USDT,ETH-USDT,SOL-USDT,XRP-USDT
ARBITRAGE_PAIRS=BTC-USDT,ETH-USDT,SOL-USDT
MOONSHOT_PAIRS=PEPE-USDT,WIF-USDT,BONK-USDT,FLOKI-USDT,SHIB-USDT

# Strategy Settings
STRATEGY=hybrid
MIN_CONFIDENCE=0.7
TAKE_PROFIT_PERCENT=5.0
STOP_LOSS_PERCENT=2.0
SCALPING_SIZE=0.10
MOMENTUM_SIZE=0.15
ARBITRAGE_SIZE=0.20
MOONSHOT_SIZE=0.05

# Monitoring
CHECK_INTERVAL=60000
HEARTBEAT_INTERVAL=300000

# Notifications
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
NOTIFY_ON_TRADE=true
NOTIFY_ON_ERROR=true
NOTIFY_DAILY_SUMMARY=true

# Risk Management
STOP_LOSS_PCT=0.02
MAX_TRADES_PER_PAIR=3
MAX_DAILY_TRADES=50
ENABLE_MARGIN=false
MARGIN_LEVERAGE=3
ENABLE_FUTURES=false
FUTURES_LEVERAGE=5